          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('week', session_date), 'DD Mon') AS \"Week\",\n       round(100.0 * count(*) FILTER (WHERE status = 'present') / count(*), 1) AS \"Present\",\n       round(100.0 * count(*) FILTER (WHERE status = 'late') / count(*), 1) AS \"Late\",\n       round(100.0 * count(*) FILTER (WHERE status = 'excused') / count(*), 1) AS \"Excused\",\n       round(100.0 * count(*) FILTER (WHERE status = 'absent') / count(*), 1) AS \"Absent\"\nFROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at)\nGROUP BY date_trunc('week', session_date) ORDER BY date_trunc('week', session_date) DESC"
        }
      ],
