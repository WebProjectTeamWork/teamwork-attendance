    {
      "type": "stat",
      "title": "Below target",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
