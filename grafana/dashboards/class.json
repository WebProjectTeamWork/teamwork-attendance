      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT starts_at AS time, round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS \"Attendance rate\"\nFROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at)\nGROUP BY session_id, starts_at ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, CAST(NULLIF('$target', '') AS numeric) AS \"Target\"\nUNION ALL SELECT $__timeTo()::timestamptz, CAST(NULLIF('$target', '') AS numeric)"
        }
      ],
