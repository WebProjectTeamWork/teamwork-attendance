    {
      "type": "timeseries",
      "title": "Attendance per session",
      "description": "The dashed line is the target.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
