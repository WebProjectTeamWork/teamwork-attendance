            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT starts_at AS time, student_name AS metric, CASE status WHEN 'present' THEN 1 WHEN 'late' THEN 2 WHEN 'excused' THEN 3 ELSE 4 END AS value\nFROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at)\nORDER BY 1, 2"
