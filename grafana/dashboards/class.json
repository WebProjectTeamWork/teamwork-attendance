      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM (SELECT 1 FROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at) GROUP BY student_id HAVING count(*) >= CAST(NULLIF('$min_sessions', '') AS integer) AND round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) < CAST(NULLIF('$target', '') AS numeric)) s"
        }
