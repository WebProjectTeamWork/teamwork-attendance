    {
      "type": "stat",
      "title": "Attendance rate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) FROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 34
        },
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Change",
      "description": "Compared with the same length of time just before the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH now_ AS (SELECT round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS r FROM reporting.student_session_status WHERE section_id = '$section' AND $__timeFilter(starts_at)),\n     before AS (SELECT round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS r FROM reporting.student_session_status WHERE section_id = '$section' AND starts_at < $__timeFrom()::timestamptz AND starts_at >= $__timeFrom()::timestamptz - ($__timeTo()::timestamptz - $__timeFrom()::timestamptz))\nSELECT CASE WHEN before.r IS NULL OR now_.r IS NULL THEN 'No earlier data'\n            WHEN now_.r = before.r THEN 'No change'\n            ELSE to_char(now_.r - before.r, 'SG990.0') || ' points' END AS \"Change\"\nFROM now_, before"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 22
        },
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2
    },
