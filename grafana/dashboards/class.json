    {
      "type": "status-history",
      "title": "Attendance register",
      "description": "One row per student, one cell per session. Hover a cell for the date and state. Empty cells: the student was not in the class yet.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
