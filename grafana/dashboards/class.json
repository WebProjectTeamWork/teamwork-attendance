          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT student_id, section_id,\n       student_name AS \"Student\", student_email AS \"Email\", section_name AS \"Class\",\n       count(*) AS \"Sessions\",\n       count(*) FILTER (WHERE status = 'absent') AS \"Absent\",\n       count(*) FILTER (WHERE status = 'late') AS \"Late\",\n       count(*) FILTER (WHERE status = 'excused') AS \"Excused\",\n       round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS \"Attendance\",\n       CASE WHEN count(*) < CAST(NULLIF('$min_sessions', '') AS integer) THEN 'Too early to tell' WHEN round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) < CAST(NULLIF('$target', '') AS numeric) THEN 'Below target' WHEN round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) < CAST(NULLIF('$target', '') AS numeric) + 5 THEN 'Close to target' ELSE 'On track' END AS \"Standing\",\n       max(starts_at) FILTER (WHERE status IN ('present', 'late')) AS \"Last seen\"\nFROM reporting.student_session_status\nWHERE section_id = '$section' AND $__timeFilter(starts_at)\nGROUP BY student_id, student_name, student_email, section_id, section_name\n\nORDER BY \"Attendance\", \"Absent\" DESC, \"Student\""
        }
