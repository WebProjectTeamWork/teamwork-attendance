    {
      "type": "timeseries",
      "title": "Attendance so far",
      "description": "The running attendance rate after each session. The dashed line is the target.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT starts_at AS time,\n       round(100.0 * sum(attended) OVER w / NULLIF(sum(1 - left_out) OVER w, 0), 1) AS \"Attendance so far\"\nFROM (SELECT starts_at, CASE WHEN (status = 'present' OR (status = 'late' AND '$late' = 'yes')) THEN 1 ELSE 0 END AS attended,\n             CASE WHEN (status = 'excused' AND '$excused' = 'skip') THEN 1 ELSE 0 END AS left_out\n      FROM reporting.student_session_status WHERE student_id = '$student' AND section_id IN ($section) AND $__timeFilter(starts_at)) s\nWINDOW w AS (ORDER BY starts_at ROWS UNBOUNDED PRECEDING)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time, CAST(NULLIF('$target', '') AS numeric) AS \"Target\"\nUNION ALL SELECT $__timeTo()::timestamptz, CAST(NULLIF('$target', '') AS numeric)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": true,
            "fillOpacity": 0,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "axisLabel": "",
            "lineInterpolation": "linear"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Attendance rate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attendance so far"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
