              "id": "byName",
              "options": "section_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Student"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the student report",
                    "url": "/d/attendance-student/student-report?var-student=${__data.fields.student_id}&${late:queryparam}&${excused:queryparam}&${target:queryparam}&${min_sessions:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Class"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the class report",
                    "url": "/d/attendance-class/class-report?var-section=${__data.fields.section_id}&${late:queryparam}&${excused:queryparam}&${target:queryparam}&${min_sessions:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attendance"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
