    {
      "type": "status-history",
      "title": "Week by week, per class",
      "description": "One row per class, one cell per week. A week with two sessions shows the worse one.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', starts_at) AS time, section_name AS metric, max(CASE status WHEN 'present' THEN 1 WHEN 'late' THEN 2 WHEN 'excused' THEN 3 ELSE 4 END) AS value\nFROM reporting.student_session_status WHERE student_id = '$student' AND section_id IN ($section) AND $__timeFilter(starts_at)\nGROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Present",
                  "color": "#2a78d6",
                  "index": 0
                },
                "2": {
                  "text": "Late",
                  "color": "#c98500",
                  "index": 1
                },
                "3": {
                  "text": "Excused",
                  "color": "#1baf7a",
                  "index": 2
                },
                "4": {
                  "text": "Absent",
                  "color": "#d03b3b",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#898781",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "colWidth": 0.92,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 11
    },
    {
      "type": "table",
      "title": "Missed and excused sessions",
      "description": "Absences, newest first, with the state of any absence request.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.starts_at AS \"Session\", s.section_name AS \"Class\", initcap(s.status) AS \"State\",\n       coalesce(initcap(r.status), 'No request') AS \"Absence request\"\nFROM reporting.student_session_status s\nLEFT JOIN LATERAL (SELECT status FROM reporting.absence_requests a\n                   WHERE a.student_id = s.student_id AND a.attendance_session_id = s.session_id\n                   ORDER BY a.created_at DESC LIMIT 1) r ON true\nWHERE s.student_id = '$student' AND s.section_id IN ($section) AND $__timeFilter(s.starts_at)\n  AND s.status IN ('absent', 'excused')\nORDER BY s.starts_at DESC"
        }
      ],
