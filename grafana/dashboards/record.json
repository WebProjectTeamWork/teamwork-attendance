          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT student_name AS \"Student\", student_email AS \"Email\",\n       to_char($__timeFrom()::timestamptz, 'YYYY-MM-DD') AS \"From\", to_char($__timeTo()::timestamptz, 'YYYY-MM-DD') AS \"To\",\n       count(DISTINCT section_id) AS \"Courses\", count(*) AS \"Sessions\", round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS \"Attendance\"\nFROM reporting.student_session_status WHERE student_id = '$student' AND section_id IN ($section) AND $__timeFilter(starts_at)\nGROUP BY student_name, student_email"
        }
      ],
