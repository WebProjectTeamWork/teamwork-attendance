    {
      "type": "table",
      "title": "Every session",
      "description": "Every session of this course in the period, oldest first, with the running percentage.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT starts_at AS \"Session\", initcap(status) AS \"Status\",\n       coalesce(initcap(r.req_status), '') AS \"Absence request\",\n       round(100.0 * sum(CASE WHEN (status = 'present' OR (status = 'late' AND '$late' = 'yes')) THEN 1 ELSE 0 END) OVER w\n             / NULLIF(count(*) OVER w - sum(CASE WHEN (status = 'excused' AND '$excused' = 'skip') THEN 1 ELSE 0 END) OVER w, 0), 1)\n         AS \"Attendance so far\"\nFROM reporting.student_session_status s\nLEFT JOIN LATERAL (SELECT a.status AS req_status FROM reporting.absence_requests a\n                   WHERE a.student_id = s.student_id AND a.attendance_session_id = s.session_id\n                   ORDER BY a.created_at DESC LIMIT 1) r ON true\nWHERE s.student_id = '$student' AND s.section_id IN ($section) AND $__timeFilter(s.starts_at)\nWINDOW w AS (ORDER BY starts_at ROWS UNBOUNDED PRECEDING)\nORDER BY starts_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
