    {
      "type": "table",
      "title": "Attendance per course",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "attendance-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "attendance-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"Course\", \"Professor\", \"Sessions\", \"Present\", \"Late\", \"Excused\", \"Absent\", \"Attendance\" FROM (\n  SELECT 0 AS o, section_name AS \"Course\", professor_name AS \"Professor\", count(*) AS \"Sessions\",\n         count(*) FILTER (WHERE status = 'present') AS \"Present\", count(*) FILTER (WHERE status = 'late') AS \"Late\",\n         count(*) FILTER (WHERE status = 'excused') AS \"Excused\", count(*) FILTER (WHERE status = 'absent') AS \"Absent\",\n         round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1) AS \"Attendance\"\n  FROM reporting.student_session_status WHERE student_id = '$student' AND section_id IN ($section) AND $__timeFilter(starts_at) GROUP BY section_name, professor_name\n  UNION ALL\n  SELECT 1, 'All courses', '', count(*), count(*) FILTER (WHERE status = 'present'),\n         count(*) FILTER (WHERE status = 'late'), count(*) FILTER (WHERE status = 'excused'),\n         count(*) FILTER (WHERE status = 'absent'), round(100.0 * count(*) FILTER (WHERE (status = 'present' OR (status = 'late' AND '$late' = 'yes'))) / NULLIF(count(*) - count(*) FILTER (WHERE (status = 'excused' AND '$excused' = 'skip')), 0), 1)\n  FROM reporting.student_session_status WHERE student_id = '$student' AND section_id IN ($section) AND $__timeFilter(starts_at)) t\nORDER BY o, \"Course\""
        }
      ],
